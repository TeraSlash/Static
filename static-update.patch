+-- the picture seen through the corpse's eyes (smoothed so a tumbling ragdoll doesn't shake the screen apart)
+local function GetRagdollEyeView()
+    if not IsValid(ragdollEnt) then return end
+
+    local pos, ang
+    local attID = ragdollEnt:LookupAttachment("eyes")
+    if attID and attID > 0 then
+        local att = ragdollEnt:GetAttachment(attID)
+        if att then
+            pos, ang = att.Pos, att.Ang
+        end
+    end
