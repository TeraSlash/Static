+                draw.RoundedBox(4, 0, 0, w, h, bgCol)
+                surface.SetDrawColor(colors.scrollbarBorder)
+                surface.DrawOutlinedRect(0, 0, w, h, 1)
+            end
+            function presetBtn:DoClick()
