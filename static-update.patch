+-- --- noise sound: white noise written to data/ once, then looped ---
+local STATIC_WAV = "zcity_death_static.wav"
+
+local function WriteString(f, str)
+    for i = 1, #str do
+        f:WriteByte(string.byte(str, i))
+    end
+end
+
+local function EnsureStaticWav()
+    if file.Exists(STATIC_WAV, "DATA") then return true end
+
+    local rate = 22050
+    local samples = rate * 2
+    local dataSize = samples * 2
+
+    local f = file.Open(STATIC_WAV, "wb", "DATA")
+    if not f then return false end
+
+    WriteString(f, "RIFF")
+    f:WriteLong(36 + dataSize)
+    WriteString(f, "WAVE")
+    WriteString(f, "fmt ")
+    f:WriteLong(16)
+    f:WriteShort(1)          -- PCM
+    f:WriteShort(1)          -- mono
+    f:WriteLong(rate)
+    f:WriteLong(rate * 2)
+    f:WriteShort(2)
+    f:WriteShort(16)
+    WriteString(f, "data")
+    f:WriteLong(dataSize)
+    for _ = 1, samples do
+        f:WriteShort(math.random(-16000, 16000))
+    end
+    f:Close()
+
+    return true
+end
+
