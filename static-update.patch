+                box:AlphaTo(0, appearance_unsaved_fade_out_time, 0)
+            end
+            overlay:AlphaTo(0, appearance_unsaved_fade_out_time, 0, function()
+                if IsValid(overlay) then
+                    overlay:Remove()
+                end
+                if fnOnClosed then
