+-- ---------------------------------------------------------------------------
+-- Guaranteed priority: other scripts hook RenderScene/CalcView too, and some of them win the race
+-- against ours. While you are dead we sit on top of hook.Call itself, so our view is asked first.
+-- ---------------------------------------------------------------------------
+local originalHookCall = nil
+local wrappedHookCall = nil
+
+local function InstallHookCallWrapper()
+    if hook.Call == wrappedHookCall then return end
+
+    originalHookCall = hook.Call
+    wrappedHookCall = function(name, gm, ...)
+        if isDead and (name == "RenderScene" or name == "CalcView") then
+            local ok, result
+            if name == "RenderScene" then
+                ok, result = pcall(CinematicDeathRenderScene, ...)
+            else
+                -- CalcView arguments: ply, origin, angles, fov, znear, zfar
+                local _, _, _, fov = ...
+                ok, result = pcall(BuildDeathView, fov)
+            end
+
+            if ok then
+                if result ~= nil then return result end
+            else
+                ErrorNoHaltWithStack(result)
+            end
+        end
+
+        return originalHookCall(name, gm, ...)
+    end
+    hook.Call = wrappedHookCall
+end
+
+local function RemoveHookCallWrapper()
+    if hook.Call == wrappedHookCall and originalHookCall then
+        hook.Call = originalHookCall
+    end
+end
+
+local nextHookCheck = 0
+local nextDebugPrint = 0
+hook.Add("Think", "DeathStaticHookCall", function()
+    if isDead and CurTime() > nextHookCheck then
+        nextHookCheck = CurTime() + 1
+        InstallHookCallWrapper()
+    elseif not isDead then
+        RemoveHookCallWrapper()
+    end
+
+    if cv_static_debug:GetBool() and CurTime() > nextDebugPrint then
+        nextDebugPrint = CurTime() + 1
+        print(string.format("[DeathStatic] isDead=%s active=%s level=%.2f ragdoll=%s authority=%s wrapper=%s noise=%s sound=%s",
+            tostring(isDead), tostring(StaticDeathActive()), GetStaticLevel(), tostring(IsValid(ragdollEnt)),
+            tostring(authorityTaken), tostring(hook.Call == wrappedHookCall),
+            tostring(noiseReady and noiseMat ~= nil), tostring(IsValid(staticStation))))
+    end
+end)
+
+print("[DeathStatic] loaded. Console: deathstatic_test (or deathstatic_test 1) to preview, deathstatic_debug 1 to print state.")
+
+
+-- ---------------------------------------------------------------------------
+-- Looking out of the corpse: hide your own hats/glasses while dead, and make sure everything this file
+-- controls is switched off again once you are alive.
+-- ---------------------------------------------------------------------------
+local aliveSince = nil
+hook.Add("Think", "DeathStaticCleanup", function()
+    local ply = LocalPlayer()
+    if not IsValid(ply) then return end
+
+    -- read by RenderAccessories (new_appearance/cl_init.lua)
+    ply.DeathHideAccessories = isDead or nil
+
+    if isDead and ply:Alive() then
+        aliveSince = aliveSince or CurTime()
+        if CurTime() - aliveSince > 0.75 then
+            -- the normal tracker should have ended the death by now; do it ourselves
+            aliveSince = nil
+            isDead = false
+            stage2Started = false
+            inTransition = false
+            inSpectator = false
+            compatActive = false
+            ReleaseAuthority()
+            RemoveHookCallWrapper()
+            RestoreRagdollHead()
+            StopStaticSound()
+            if IsValid(ragdollEnt) then ragdollEnt:SetNoDraw(false) end
+            ragdollEnt = nil
+            ply.DeathHideAccessories = nil
+        end
+    else
+        aliveSince = nil
+    end
+end)
